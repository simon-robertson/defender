  "reproduction": {
    "coreSupplementSource": "\nimport {actorsForPreview} from \"./game/preview-actors.js\";import {buildWorld,disposeWorld} from \"./engine/world.js\";import {EnemyPreview} from \"./game/enemy-preview.js\";import {DefencePreview} from \"./game/defence-preview.js\";import {DRONE_ROTORS,DRONE_MODEL} from \"./shared/drone-model.js\";import {DRONE_PREVIEW} from \"./shared/drone.js\";\nconst level=await Bun.file(\"assets/levels/moss-01.json\").json(),actors=actorsForPreview(level),models=new Map();for(const id of new Set([...level.placements.map(p=>p.model),...actors.map(a=>a.model)]))models.set(id,await Bun.file(\"assets/models/\"+id+\".json\").json());const w=buildWorld(level,models,{actors}),e=new EnemyPreview(w,()=>{});for(const t of e.states)t.health.current=t.health.maximum=100000;const d=new DefencePreview(w,()=>{},()=>.5,null,e.states,()=>0);\nconst m=d.drones.states.map(s=>({v:[0,0,0],maxAcceleration:0,jumps:0,bodyTilt:0,goal:s.goalNode,goalChanges:0,distance:0}));\nconst physical=d.drones.states.map(s=>({position:[s.x,s.y,s.z],v:[0,0,0],maxAcceleration:0,maxSpeed:0,jumps:0,distance:0,maxBodyUpError:0,maxFanTilt:0,maxRotorNormalMismatch:0,staticFailures:0,nonfinite:0,emergencyStops:0}));\nfor(let f=0;f<3600;f++){e.advance(1/60);d.advance(1/60);d.drones.states.forEach((s,i)=>{\n const r=m[i],v=[s.velocityX,s.velocityY,s.velocityZ],dv=Math.hypot(v[0]-r.v[0],v[1]-r.v[1],v[2]-r.v[2]);r.maxAcceleration=Math.max(r.maxAcceleration,dv*60);if(dv>8)r.jumps++;r.bodyTilt=Math.max(r.bodyTilt,Math.abs(s.bodyPitch),Math.abs(s.bodyRoll));r.distance+=Math.hypot(...v)/60;if(s.goalNode!==r.goal){r.goal=s.goalNode;r.goalChanges++;}r.v=v;\n const q=physical[i],pos=[s.x,s.y,s.z],pv=pos.map((x,j)=>(x-q.position[j])*60),pdv=Math.hypot(...pv.map((x,j)=>x-q.v[j]));q.maxAcceleration=Math.max(q.maxAcceleration,pdv*60);q.maxSpeed=Math.max(q.maxSpeed,Math.hypot(...pv));if(pdv>8)q.jumps++;q.distance+=Math.hypot(...pv)/60;q.v=pv;q.position=pos;\n const b=s.bodyMatrix;q.maxBodyUpError=Math.max(q.maxBodyUpError,Math.abs(b[4]),Math.abs(b[6]),Math.abs(b[5]-1));for(const rotor of DRONE_ROTORS){const fan=s.rig.byId.get(rotor.gimbal).instance.matrix,spin=s.rig.byId.get(rotor.id).instance.matrix;q.maxFanTilt=Math.max(q.maxFanTilt,Math.acos(Math.max(-1,Math.min(1,fan[5]))));q.maxRotorNormalMismatch=Math.max(q.maxRotorNormalMismatch,Math.hypot(fan[4]-spin[4],fan[5]-spin[5],fan[6]-spin[6]));}\n if(![\"launch\",\"descend\",\"pad-hover\",\"recharge\"].includes(s.phase)&&!d.drones.navigation.clearSegment(s.x,s.y,s.z,s.x,s.y,s.z))q.staticFailures++;if(![...s.bodyMatrix,...s.gunMatrix,s.x,s.y,s.z].every(Number.isFinite))q.nonfinite++;q.emergencyStops=s.emergencyStops;\n});}\nconsole.log(JSON.stringify({after:m,displacement:physical,states:d.drones.states.map(s=>({id:s.id,phase:s.phase,launches:s.launches,returns:s.returns,holds:s.holds,routeChanges:s.routeChanges,stationChanges:s.stationChanges,emergencyStops:s.emergencyStops})),tuning:DRONE_PREVIEW,fanTiltCap:DRONE_MODEL.fanTiltMax,minimumFanTiltLift:DRONE_MODEL.minimumFanTiltLift}));\nd.dispose();e.dispose();disposeWorld(w);",
    "wildlifeSupplementSource": "\nimport {actorsForPreview} from \"./game/preview-actors.js\";import {buildWorld,disposeWorld} from \"./engine/world.js\";import {EnemyPreview} from \"./game/enemy-preview.js\";import {DefencePreview} from \"./game/defence-preview.js\";import {DRONE_ROTORS,DRONE_MODEL} from \"./shared/drone-model.js\";import {DRONE_PREVIEW} from \"./shared/drone.js\";\nimport {WildlifePreview} from \"./game/wildlife-preview.js\";\nconst level=await Bun.file(\"assets/levels/moss-01.json\").json(),actors=actorsForPreview(level),models=new Map();for(const id of new Set([...level.placements.map(p=>p.model),...actors.map(a=>a.model)]))models.set(id,await Bun.file(\"assets/models/\"+id+\".json\").json());const w=buildWorld(level,models,{actors}),e=new EnemyPreview(w,()=>{});for(const t of e.states)t.health.current=t.health.maximum=100000;const d=new DefencePreview(w,()=>{},()=>.5,null,e.states,()=>0);\nconst wildlife=new WildlifePreview(w,()=>{});wildlife.setThreatSources(e.states);d.drones.setWildlife(wildlife.states);\nconst extra=d.drones.states.map(s=>({id:s.id,currentHoldSeconds:0,maxHoldSeconds:0,holdEnemyTravel:0,currentEnemyDistance:0,previousEnemyDistance:0,previousTarget:null,holdEnemyTravelPeak:0,burstGoalChanges:0,previousGoal:-1,dynamicBlockedFrames:0,firstDynamicBlock:null}));\nconst m=d.drones.states.map(s=>({v:[0,0,0],maxAcceleration:0,jumps:0,bodyTilt:0,goal:s.goalNode,goalChanges:0,distance:0}));\nconst physical=d.drones.states.map(s=>({position:[s.x,s.y,s.z],v:[0,0,0],maxAcceleration:0,maxSpeed:0,jumps:0,distance:0,maxBodyUpError:0,maxFanTilt:0,maxRotorNormalMismatch:0,staticFailures:0,nonfinite:0,emergencyStops:0}));\nfor(let f=0;f<3600;f++){e.advance(1/60);wildlife.advance(1/60);d.advance(1/60);d.drones.states.forEach((s,i)=>{\n const ex=extra[i],t=s.target,held=s.stationCommitted&&s.speed<.1&&t&&s.phase!==\"return\";\n if(held&&t===ex.previousTarget){ex.currentHoldSeconds+=1/60;ex.holdEnemyTravel+=Math.max(0,t.distance-ex.previousEnemyDistance);}else{ex.currentHoldSeconds=0;ex.holdEnemyTravel=0;}\n ex.maxHoldSeconds=Math.max(ex.maxHoldSeconds,ex.currentHoldSeconds);ex.holdEnemyTravelPeak=Math.max(ex.holdEnemyTravelPeak,ex.holdEnemyTravel);\n if(s.cycle.remaining&&ex.previousGoal!==-1&&s.goalNode!==ex.previousGoal)ex.burstGoalChanges++;\n if(!d.drones.dynamicPointClear(s,s.x,s.y,s.z,0)){ex.dynamicBlockedFrames++;ex.firstDynamicBlock??={frame:f,phase:s.phase,blocker:d.drones.obstacles.lastBlockedId,position:[s.x,s.y,s.z]};}\n ex.previousGoal=s.goalNode;ex.previousTarget=t;ex.previousEnemyDistance=t?.distance??0;\n const r=m[i],v=[s.velocityX,s.velocityY,s.velocityZ],dv=Math.hypot(v[0]-r.v[0],v[1]-r.v[1],v[2]-r.v[2]);r.maxAcceleration=Math.max(r.maxAcceleration,dv*60);if(dv>8)r.jumps++;r.bodyTilt=Math.max(r.bodyTilt,Math.abs(s.bodyPitch),Math.abs(s.bodyRoll));r.distance+=Math.hypot(...v)/60;if(s.goalNode!==r.goal){r.goal=s.goalNode;r.goalChanges++;}r.v=v;\n const q=physical[i],pos=[s.x,s.y,s.z],pv=pos.map((x,j)=>(x-q.position[j])*60),pdv=Math.hypot(...pv.map((x,j)=>x-q.v[j]));q.maxAcceleration=Math.max(q.maxAcceleration,pdv*60);q.maxSpeed=Math.max(q.maxSpeed,Math.hypot(...pv));if(pdv>8)q.jumps++;q.distance+=Math.hypot(...pv)/60;q.v=pv;q.position=pos;\n const b=s.bodyMatrix;q.maxBodyUpError=Math.max(q.maxBodyUpError,Math.abs(b[4]),Math.abs(b[6]),Math.abs(b[5]-1));for(const rotor of DRONE_ROTORS){const fan=s.rig.byId.get(rotor.gimbal).instance.matrix,spin=s.rig.byId.get(rotor.id).instance.matrix;q.maxFanTilt=Math.max(q.maxFanTilt,Math.acos(Math.max(-1,Math.min(1,fan[5]))));q.maxRotorNormalMismatch=Math.max(q.maxRotorNormalMismatch,Math.hypot(fan[4]-spin[4],fan[5]-spin[5],fan[6]-spin[6]));}\n if(![\"launch\",\"descend\",\"pad-hover\",\"recharge\"].includes(s.phase)&&!d.drones.navigation.clearSegment(s.x,s.y,s.z,s.x,s.y,s.z))q.staticFailures++;if(![...s.bodyMatrix,...s.gunMatrix,s.x,s.y,s.z].every(Number.isFinite))q.nonfinite++;q.emergencyStops=s.emergencyStops;\n});}\nconsole.log(JSON.stringify({after:m,displacement:physical,extra:extra.map(({previousTarget,...r})=>r),obstacles:d.drones.obstacles.inspect(),states:d.drones.states.map(s=>({id:s.id,phase:s.phase,launches:s.launches,returns:s.returns,holds:s.holds,routeChanges:s.routeChanges,stationChanges:s.stationChanges,emergencyStops:s.emergencyStops})),tuning:DRONE_PREVIEW,fanTiltCap:DRONE_MODEL.fanTiltMax,minimumFanTiltLift:DRONE_MODEL.minimumFanTiltLift}));\nd.dispose();wildlife.dispose();e.dispose();disposeWorld(w);",
    "underneathSource": "\nimport {newLevel} from \"./shared/level.js\";import {buildWorld,disposeWorld} from \"./engine/world.js\";import {Health} from \"./engine/health.js\";import {DefencePreview} from \"./game/defence-preview.js\";\nconst drone=await Bun.file(\"assets/models/drone-defence.json\").json(),level=newLevel(\"review-underneath\");level.size=[12,10];level.placements=[{id:\"drone-1\",model:drone.id,variant:\"base\",box:[5,0,5],turn:0}];\nconst world=buildWorld(level,new Map([[drone.id,drone]])),target={id:\"same-enemy\",x:132,z:84,aimX:132,aimY:34.5,aimZ:84,lap:0,health:new Health(10000),threat:1,movement:{speed:0}};\nconst shots=[],f=new DefencePreview(world,()=>{},()=>.5,()=>shots.push({time:f.drones.time,id:f.drones.states[0].lastShotTargetId,pos:[s.x,s.y,s.z]}),[target],(t,n)=>t.health.takeDamage(n)),s=f.drones.states[0];let changed=null,afterShot=null,minSpeed=Infinity;\nfor(let frame=0;frame<1200;frame++){f.advance(1/60);if(changed===null&&shots.length===1){changed={time:f.drones.time,goal:s.goalNode,remaining:s.cycle.remaining,pos:[s.x,s.y,s.z]};target.x=target.aimX=s.x;target.z=target.aimZ=s.z;}else if(changed&&shots.length>1&&!afterShot)afterShot={time:f.drones.time,goal:s.goalNode,remaining:s.cycle.remaining,pos:[s.x,s.y,s.z],shot:shots.at(-1)};}\nconsole.log(JSON.stringify({changed,afterShot,shots,phase:s.phase,goal:s.goalNode,stationChanges:s.stationChanges,emergencies:s.emergencyStops}));f.dispose();disposeWorld(world);\n",
    "outOfRangeSource": "\nimport {newLevel} from \"./shared/level.js\";import {buildWorld,disposeWorld} from \"./engine/world.js\";import {Health} from \"./engine/health.js\";import {DefencePreview} from \"./game/defence-preview.js\";\nconst drone=await Bun.file(\"assets/models/drone-defence.json\").json(),level=newLevel(\"review-underneath\");level.size=[12,10];level.placements=[{id:\"drone-1\",model:drone.id,variant:\"base\",box:[5,0,5],turn:0}];\nconst world=buildWorld(level,new Map([[drone.id,drone]])),target={id:\"same-enemy\",x:132,z:84,aimX:132,aimY:34.5,aimZ:84,lap:0,health:new Health(10000),threat:1,movement:{speed:0}};\nconst shots=[],f=new DefencePreview(world,()=>{},()=>.5,()=>shots.push({time:f.drones.time,id:f.drones.states[0].lastShotTargetId,pos:[s.x,s.y,s.z]}),[target],(t,n)=>t.health.takeDamage(n)),s=f.drones.states[0];let changed=null,afterShot=null,minSpeed=Infinity;\nfor(let frame=0;frame<1200;frame++){f.advance(1/60);if(changed===null&&shots.length===1){changed={time:f.drones.time,goal:s.goalNode,remaining:s.cycle.remaining,pos:[s.x,s.y,s.z]};target.x=target.aimX=s.x+100;target.z=target.aimZ=s.z;}else if(changed&&shots.length>1&&!afterShot)afterShot={time:f.drones.time,goal:s.goalNode,remaining:s.cycle.remaining,pos:[s.x,s.y,s.z],shot:shots.at(-1)};}\nconsole.log(JSON.stringify({changed,afterShot,shots,phase:s.phase,goal:s.goalNode,stationChanges:s.stationChanges,emergencies:s.emergencyStops}));f.dispose();disposeWorld(world);\n",
    "expiryDuringEvasionSource": "\nimport {newLevel} from \"./shared/level.js\";import {buildWorld,disposeWorld} from \"./engine/world.js\";import {Health} from \"./engine/health.js\";import {DefencePreview} from \"./game/defence-preview.js\";\nconst drone=await Bun.file(\"assets/models/drone-defence.json\").json(),level=newLevel(\"review-underneath\");level.size=[12,10];level.placements=[{id:\"drone-1\",model:drone.id,variant:\"base\",box:[5,0,5],turn:0}];\nconst world=buildWorld(level,new Map([[drone.id,drone]])),target={id:\"same-enemy\",x:132,z:84,aimX:132,aimY:34.5,aimZ:84,lap:0,health:new Health(10000),threat:1,movement:{speed:0}};\nconst shots=[],f=new DefencePreview(world,()=>{},()=>.5,()=>shots.push({time:f.drones.time,id:f.drones.states[0].lastShotTargetId,pos:[s.x,s.y,s.z]}),[target],(t,n)=>t.health.takeDamage(n)),s=f.drones.states[0];let changed=null,afterShot=null,minSpeed=Infinity;let attackAfterExpiry=0,maxReturns=0,phases=[];\nfor(let frame=0;frame<900;frame++){f.advance(1/60);if(changed===null&&shots.length===1){s.cycle.cancelBurst();s.flightElapsed=19.9;const started=f.drones.planEvasion(s);changed={time:f.drones.time,started,resume:s.evadeResume,phase:s.phase,returns:s.returns};}if(changed){if(s.expired&&s.phase===\"attack\")attackAfterExpiry++;maxReturns=Math.max(maxReturns,s.returns);if(phases.at(-1)?.phase!==s.phase)phases.push({time:f.drones.time,phase:s.phase,evading:s.evading,expired:s.expired,returns:s.returns});}}\nconsole.log(JSON.stringify({changed,attackAfterExpiry,maxReturns,phases,afterShot,shots,phase:s.phase,goal:s.goalNode,stationChanges:s.stationChanges,emergencies:s.emergencyStops}));f.dispose();disposeWorld(world);\n",
